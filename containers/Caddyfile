# Caddyfile for NOLA Camera Mapping
# Site address comes from DOMAIN (set in .env). Caddy auto-provisions TLS for domains.

{$DOMAIN:localhost} {
    # Enable compression
    encode gzip

    # Handle static files
    handle /static/* {
        root * /srv
        file_server
    }

    # Handle media files (uploaded images)
    handle /media/* {
        root * /srv
        file_server
    }

    # Proxy everything else to Django
    handle {
        reverse_proxy web:8000 {
            header_up X-Forwarded-Proto {scheme}
            header_up X-Real-IP {remote_host}
        }
    }

    # Logging — JSON format to file so GoatCounter can import from it.
    # IP fields are stripped before they ever reach disk: reporters submitting
    # camera locations should not have their own IP address retained anywhere.
    log {
        output file /var/log/caddy/access.log {
            roll_size 100mb
            roll_keep 5
        }
        format filter {
            wrap json
            fields {
                request>remote_ip delete
                request>client_ip delete
                request>headers>X-Forwarded-For delete
                request>headers>X-Real-Ip delete
            }
        }
    }
}

# GoatCounter analytics dashboard : basic auth gate before the GoatCounter login
stats.{$DOMAIN:localhost} {
    basicauth {
        {$STATS_USER} {$STATS_PASSWORD_HASH}
    }
    reverse_proxy goatcounter:8080 {
        header_up X-Forwarded-For {remote_host}
        header_up X-Real-IP {remote_host}
    }
}
